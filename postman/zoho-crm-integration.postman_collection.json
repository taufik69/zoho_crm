    {
      "name": "3 \u2014 Create Lead",
      "item": [
        {
          "name": "Create Lead",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/crm/leads",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "crm",
                "leads"
              ]
            },
            "description": "Point 3. lastName and company required; firstName, email, phone optional. Returns 201 { id } and saves it to {{leadId}}. Then refresh Zoho CRM \u2192 Leads to see it.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"company\": \"Postman Test Ltd\",\n  \"email\": \"jane.doe@example.com\",\n  \"phone\": \"+8801711111111\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('envelope shape', () => { const b = pm.response.json(); pm.expect(b).to.have.keys(['success','statusCode','message','data'].concat(b.pagination ? ['pagination'] : [])); });",
                  "const id = pm.response.json().data && pm.response.json().data.id;",
                  "if (id) { pm.collectionVariables.set('leadId', id); console.log('leadId =', id); }"
                ]
              }
            }
          ]
        }
      ]
    },
