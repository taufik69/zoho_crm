{
  "info": {
    "name": "Zoho CRM Integration",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "W3SCLOUD assessment, Part 1. Run order: Health \u2192 Auth/Status (connect in a BROWSER first, not Postman) \u2192 CRM \u2192 Error demos.\n\nCreate Lead saves the returned id into the `leadId` collection variable, so Get Lead by ID works right after."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "leadId",
      "value": "7617346000000702001"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Liveness probe. Raw body, not the envelope."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "1 \u2014 Auth (OAuth)",
      "item": [
        {
          "name": "Connect (open in browser)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/connect",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "connect"
              ]
            },
            "description": "Point 1. Returns 302 to the Zoho consent page. OPEN THIS URL IN A BROWSER, log in, click Accept. In Postman you only see the 302 (turn off Settings \u2192 Automatically follow redirects to see the Location header)."
          }
        },
        {
          "name": "Callback (Zoho calls this)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/callback?code=<from-zoho>&state=<from-connect>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "callback"
              ],
              "query": [
                {
                  "key": "code",
                  "value": "<from-zoho>",
                  "description": "Authorization code \u2014 Zoho puts it here"
                },
                {
                  "key": "state",
                  "value": "<from-connect>",
                  "description": "Must be a state issued by /connect, single use"
                }
              ]
            },
            "description": "Zoho redirects the browser here after Accept. Calling it by hand with made-up values returns 400 \"Invalid or expired OAuth state\" \u2014 that is the CSRF protection working."
          }
        },
        {
          "name": "Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "status"
              ]
            },
            "description": "connected true/false, expiresAt, apiDomain, scopes. Never returns a token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('envelope shape', () => { const b = pm.response.json(); pm.expect(b).to.have.keys(['success','statusCode','message','data'].concat(b.pagination ? ['pagination'] : [])); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh access token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "refresh"
              ]
            },
            "description": "Forces a refresh from the stored refresh token. expiresAt moves forward. 401 if not connected."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('envelope shape', () => { const b = pm.response.json(); pm.expect(b).to.have.keys(['success','statusCode','message','data'].concat(b.pagination ? ['pagination'] : [])); });"
                ]
              }
            }
          ]
        }
      ]
    },
