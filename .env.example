# Copy to .env and fill in. Every var listed in REQUIRED_ENV_VARS in
# src/config/env.js must be present or the server exits at startup.
# Never commit .env — it holds the Zoho client secret.

PORT=5000
NODE_ENV=development

# --- Zoho OAuth client ---
# Register a "Server-based Application" at https://api-console.zoho.com
# (use the console for YOUR data centre: .com, .eu, .in, .com.au, .jp ...).
ZOHO_CLIENT_ID="1000.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
ZOHO_CLIENT_SECRET="change-me"

# Must match the "Authorized Redirect URI" registered in the API console
# character for character, or Zoho rejects the authorization request.
ZOHO_REDIRECT_URI="http://localhost:5000/api/v1/auth/callback"

# Accounts server for your data centre. Optional — defaults to .com.
# India: https://accounts.zoho.in   EU: https://accounts.zoho.eu
ZOHO_ACCOUNTS_URL="https://accounts.zoho.com"

# Comma-separated OAuth scopes requested on consent. Optional.
# Changing this requires re-authorizing: a stored refresh token keeps the
# scopes it was issued with (OAUTH_SCOPE_MISMATCH otherwise).
ZOHO_SCOPES="ZohoCRM.modules.leads.ALL,ZohoCRM.modules.contacts.READ,ZohoCRM.modules.accounts.READ"

# Browser origin allowed through CORS. Optional — defaults to "*".
CLIENT_ORIGIN="http://localhost:3000"

# Pino log level: fatal | error | warn | info | debug | trace | silent.
# Optional — defaults to "debug" in development and "info" otherwise.
LOG_LEVEL="debug"

# Redis response cache (optional; API falls back to Zoho if unavailable).
REDIS_URL="redis://localhost:6379"
REDIS_CACHE_TTL_SECONDS=300
